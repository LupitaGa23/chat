<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/negro"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/negro_suave"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="Volver"
            android:scaleType="centerInside" />

        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="4dp">
            <TextView
                android:id="@+id/tvHeaderInitial"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_avatar_circle"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                android:text="?" />
            <ImageView
                android:id="@+id/ivHeaderAvatar"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:visibility="gone"
                android:scaleType="centerCrop" />
            <View
                android:id="@+id/dotOnline"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="end|bottom"
                android:background="@drawable/bg_online_dot"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvChatName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/texto"
                android:textSize="16sp"
                android:textStyle="bold"
                android:singleLine="true" />
            <TextView
                android:id="@+id/tvChatStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/texto_muted"
                android:textSize="12sp"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#14FFFFFF" />

    <!-- Messages -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="12dp" />

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#14FFFFFF" />

    <!-- Input bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/negro_suave"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnAttach"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_add"
            android:contentDescription="Adjuntar"
            android:scaleType="centerInside" />

        <ImageButton
            android:id="@+id/btnMic"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_btn_speak_now"
            android:contentDescription="Grabar audio"
            android:scaleType="centerInside" />

        <EditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="@string/hint_message"
            android:textColorHint="@color/texto_dark"
            android:textColor="@color/texto"
            android:textSize="14sp"
            android:paddingHorizontal="14dp"
            android:singleLine="true"
            android:imeOptions="actionSend"
            android:layout_marginHorizontal="6dp" />

        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_send_btn"
            android:src="@android:drawable/ic_menu_send"
            android:contentDescription="Enviar"
            android:scaleType="centerInside"
            android:padding="10dp" />
    </LinearLayout>

    <!-- Recording indicator -->
    <LinearLayout
        android:id="@+id/recordingBar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="#14EF5350"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:visibility="gone">
        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_online_dot"
            android:backgroundTint="@color/error" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="  Grabando nota de voz… toca el micrófono para enviar."
            android:textColor="@color/texto"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
